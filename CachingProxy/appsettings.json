{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore.DataProtection.KeyManagement.XmlKeyManager": "Error",
      "System.Net.Http.HttpClient": "Warning",
      "ZiggyCreatures.Caching.Fusion.FusionCache": "Warning"
    }
  },
  "Sentry": {
    "Dsn": "",
    "SendDefaultPii": true,
    "MinimumBreadcrumbLevel": "Information",
    "MinimumEventLevel": "Warning"
  },
  "CachingProfiles": {
    "maven": {
      "Rules": [
        { "Pattern": "maven-metadata\\.xml(\\..+)?$", "RefreshAfter": "01:00:00" },
        { "Pattern": "archetype-catalog\\.xml(\\..+)?$", "RefreshAfter": "01:00:00" },
        { "Pattern": "-SNAPSHOT", "RefreshAfter": "1.00:00:00" }
      ]
    }
  }
}
