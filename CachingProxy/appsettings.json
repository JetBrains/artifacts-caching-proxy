{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore.DataProtection.KeyManagement.XmlKeyManager": "Error",
      "System.Net.Http.HttpClient": "Warning",
      "ZiggyCreatures.Caching.Fusion.FusionCache": "Warning"
    }
  },
  "Sentry": {
    "Dsn": "",
    "SendDefaultPii": false,
    "MinimumBreadcrumbLevel": "Information",
    "MinimumEventLevel": "Warning"
  },
  "CachingProfiles": {
    "maven": {
      "Rules": [
        { "Pattern": "maven-metadata\\.xml(\\..+)?$", "RefreshAfter": "01:00:00" },
        { "Pattern": "archetype-catalog\\.xml(\\..+)?$", "RefreshAfter": "01:00:00" },
        { "Pattern": "-SNAPSHOT", "RefreshAfter": "01:00:00" }
      ]
    },
    "npm": {
      "Rules": [
        { "Pattern": "-/npm/v1/security/", "Redirect": true },
        { "Pattern": "-/v1/search", "Redirect": true },
        { "Pattern": "\\.tgz$" },
        { "Pattern": ".", "RefreshAfter": "01:00:00" }
      ]
    },
    "docker": {
      "//": "OCI distribution (Docker registry v2). Digest-addressed blobs and manifests are content-addressed, hence immutable and cached forever; tags, tag lists and referrers are mutable, so they revalidate on a short window. _catalog is a dynamic listing. The catch-all is a short window rather than a redirect, so an unrecognised endpoint is never bounced to an origin the client has no credentials for. Layers are far larger than the artifacts this cache was sized for: check RequestTimeoutSec (it bounds the body read too), MinimumFreeDiskSpaceMb and the bucket lifecycle before enabling widely.",
      "Oci": true,
      "Rules": [
        { "Pattern": "/blobs/[a-z0-9]+(?:[+._-][a-z0-9]+)*:[0-9a-fA-F]{32,}$" },
        { "Pattern": "/manifests/[a-z0-9]+(?:[+._-][a-z0-9]+)*:[0-9a-fA-F]{32,}$", "VaryByAccept": true },
        { "Pattern": "/manifests/", "RefreshAfter": "00:05:00", "VaryByAccept": true },
        { "Pattern": "/tags/list", "RefreshAfter": "00:05:00" },
        { "Pattern": "/referrers/", "RefreshAfter": "00:05:00" },
        { "Pattern": "/_catalog", "Redirect": true },
        { "Pattern": ".", "RefreshAfter": "00:05:00" }
      ]
    }
  }
}
