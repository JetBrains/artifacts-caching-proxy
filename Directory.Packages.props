<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- App packages -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <PackageVersion Include="Duende.AccessTokenManagement" Version="4.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.19.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <!-- The release built against the AWSSDK.Core (4.0.102.6) the other AWSSDK packages resolve. -->
    <PackageVersion Include="AWSSDK.CodeArtifact" Version="4.0.100.14" />
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.101.4" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.103.4" />
    <!-- Loaded by the default credential chain for web identity (AWS_ROLE_ARN + AWS_WEB_IDENTITY_TOKEN_FILE). -->
    <PackageVersion Include="AWSSDK.SecurityToken" Version="4.0.101" />
    <PackageVersion Include="AWSSDK.SSO" Version="4.0.100.16" />
    <PackageVersion Include="AWSSDK.SSOOIDC" Version="4.0.100.15" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <!-- Direct dependency: Program.cs builds the multiplexer itself. Held ahead of the 2.7.27 that
         Microsoft.Extensions.Caching.StackExchangeRedis asks for, which predates the write-failure
         queue-desync teardown, TCP keep-alives, and Valkey 8+ server-mode detection. -->
    <PackageVersion Include="StackExchange.Redis" Version="3.3.1" />
    <PackageVersion Include="Sentry.AspNetCore" Version="6.11.1" />
    <!-- Test packages -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.CysharpMemoryPack" Version="2.9.0" />
  </ItemGroup>
</Project>